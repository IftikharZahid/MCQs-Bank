{
  "name": "qb-platform-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "seed:admin": "cd backend && npm run seed:admin",
    "audit:db": "cd backend && npm run audit:db",
    "migrate:legacy": "cd backend && npm run migrate:legacy",
    "build": "cd frontend && npm install && npm run build && node --input-type=module -e \"import fs from 'node:fs'; fs.cpSync('../dist', 'dist', {recursive: true, force: true});\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "mongoose": "^8.6.1",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1"
  }
}