{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Academic Question Bank & Examination Portal",
  "short_name": "MCQs Bank",
  "description": "Comprehensive Academic Question Bank, Practice Simulator, and Examination Portal for Higher Education.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#0B1536",
  "theme_color": "#0B1536",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "education",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Practice MCQs",
      "short_name": "Practice",
      "description": "Start an interactive MCQ practice session",
      "url": "/practice",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Exam Simulator",
      "short_name": "Exam",
      "description": "Launch a timed mock examination",
      "url": "/exam",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Subject Catalog",
      "short_name": "Catalog",
      "description": "Browse subjects, chapters, and question banks",
      "url": "/catalog",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "prefer_related_applications": false
}
